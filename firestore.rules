rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidIcon(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'description', 'connections', 'createdBy', 'createdAt'])
        && data.keys().size() == 7
        && data.id is string && data.id.size() <= 100
        && data.name is string && data.name.size() <= 100
        && data.category in ['Music', 'Activism', 'Drag', 'Art', 'Film/TV']
        && data.description is string && data.description.size() <= 1000
        && data.connections is list
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time;
    }

    match /icons/{iconId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && isValidId(iconId)
        && isValidIcon(request.resource.data);
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
